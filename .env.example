# Chuỗi kết nối PostgreSQL mẫu; không điền thông tin đăng nhập thật vào file này.
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/lol_prepost

# Fandom bot account dùng riêng cho Leaguepedia Cargo.

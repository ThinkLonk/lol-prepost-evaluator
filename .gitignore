# Môi trường Python
.venv/
venv/
env/

# Biến môi trường và bí mật cục bộ
.env
.env.*
!.env.example

# Bí mật Streamlit
.streamlit/secrets.toml

# Bộ nhớ đệm và tệp sinh bởi công cụ
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Cấu hình trình soạn thảo và hệ điều hành
.idea/
.vscode/
.DS_Store
Thumbs.db

# Dữ liệu thô, báo cáo sinh tự động và model artifacts
data/raw/*
!data/raw/.gitkeep
reports/data_quality/*
!reports/data_quality/.gitkeep
artifacts/models/*
!artifacts/models/.gitkeep
*.joblib
*.pkl

# Nhật ký chạy cục bộ
*.log

# Công cụ AI/agent chỉ dùng local
/AGENTS.md
/.agents/
/.codex/
/.claude/
/.cursor/
/CLAUDE.md

# Helper tạm được xuất từ sync_players
/browser_exporter.js

# Media tải từ nguồn ngoài
# Champion assets nhỏ và bắt buộc nên vẫn được commit.
/assets/teams/*
!/assets/teams/.gitkeep
/assets/players/*
!/assets/players/.gitkeep

# Manifest và file tải dở chỉ dùng local
/assets/**/_sync_manifest.json
/assets/**/*.part